# Copy this file to .env and fill in the values.

# PostgreSQL. This default matches docker-compose.yml (local dev only).
# On Vercel, use the Neon connection string instead.
DATABASE_URL="postgresql://forceout:forceout@localhost:5432/forceout"
# Only on Vercel with Neon (set by the Neon integration): a direct, unpooled
# connection that migrations use. Leave it unset locally.
# DATABASE_URL_UNPOOLED=

# Better Auth. Secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Protects /api/cron/daily. Any long random string: openssl rand -hex 24
CRON_SECRET=
